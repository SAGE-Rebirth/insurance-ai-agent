# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_KEY=your_gemini_api_key_here

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/insurevoice?retryWrites=true&w=majority

# Redis connection URL
# Local: redis://localhost:6379
# Redis Cloud: redis://:<password>@<host>:<port>
# AWS ElastiCache: redis://<primary-endpoint>:6379
REDIS_URL=redis://localhost:6379

# Gemini API Key (kept server-side for future proxy use)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:3000
